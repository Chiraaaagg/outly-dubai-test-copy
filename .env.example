# =============================================================================
#  OUTLYY — environment configuration
# =============================================================================
#
#  HOW TO USE
#  1. Copy this file:            cp .env.example .env.local
#  2. Paste keys one by one.     Leave a value blank to disable that integration
#                                (the app falls back to the mock/log adapter).
#  3. Never commit .env.local.   It is already in .gitignore (.env*.local).
#
#  NAMING
#  NEXT_PUBLIC_*  → shipped to the browser. Only ever put PUBLIC identifiers here
#                   (pixel IDs, site keys, phone numbers). Never a secret.
#  Everything else is server-only.
#
#  ENVIRONMENTS (docs/backend/14-deployment.md §1)
#  dev      → test keys, mock Rathin, log-only WhatsApp, Resend catch-all
#  staging  → test keys, BSP sandbox number, recipient allowlist ON
#  prod     → live keys only here. Never a live payment or BSP credential elsewhere.
#
#  Sections are ordered by launch priority. Phase B (WhatsApp + email ack) is
#  the launchable line per docs/backend/17-inquiry-mode-pivot.md.
# =============================================================================


# -----------------------------------------------------------------------------
#  0. APP
# -----------------------------------------------------------------------------
NODE_ENV=development
# development | staging | production — drives adapter selection and the
# non-production recipient allowlist. Keep in sync with NODE_ENV.
APP_ENV=development

# Canonical origin. Used for absolute URLs in WhatsApp messages, emails,
# sitemap, canonicals and payment-link redirects. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement id (G-...). The ONE name for it: the head
# tag, the CSP origins and the server forwarder all read it through
# src/lib/ga-config.ts. Storefront only, never on /admin or private customer
# pages; the tag starts with consent denied (src/lib/google-tag.ts). Unset =
# no tag is shipped at all, and the CSP stays tight.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Display currency. AED and INR are stored; USD is derived from AED at the UAE
# central-bank peg (3.6725 AED = 1 USD, fixed since 1997), so no rate API is
# called. Override only to apply a different display rate.
# NEXT_PUBLIC_AED_PER_USD=3.6725

# Public Google listing for the sister brand whose reviews we republish.
# Unset = the "read them on Google" link does not render.
# NEXT_PUBLIC_SISTER_REVIEWS_URL=

# Public WhatsApp number for click-to-chat links (digits only, with country code).
# Currently mocked in src/lib/whatsapp.ts → WHATSAPP_NUMBER.
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000

# Displayed on vouchers, support pages and the maintenance page.
NEXT_PUBLIC_EMERGENCY_PHONE=+97140000000
NEXT_PUBLIC_SUPPORT_EMAIL=help@outlyy.com
# Legal identifiers shown in the footer, contact page and legal pages. Leave
# blank until the real values exist — nothing is rendered when unset (never a
# placeholder; audit S01/X03).
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_DED_LICENCE=
NEXT_PUBLIC_VAT_TRN=
NEXT_PUBLIC_REGISTERED_ADDRESS=
NEXT_PUBLIC_GRIEVANCE_NAME=
NEXT_PUBLIC_GRIEVANCE_EMAIL=
# Indian GST number — only if an Indian entity invoices Indian customers.
NEXT_PUBLIC_GSTIN=

# Client analytics transport. src/lib/analytics.ts → deliver() posts here.
# Leave blank to keep events in the in-memory buffer only.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=/api/events


# -----------------------------------------------------------------------------
#  1. DATABASE — Supabase Postgres 17 (production)
#  Get: Supabase dashboard → project → Connect.
#  The app uses the POOLED string (Supavisor, transaction mode, port 6543);
#  Prisma migrations use the DIRECT/session string (port 5432).
#  Tests and the db:* scripts never read this file's database: they use the
#  disposable local Postgres in .env.test.local (scripts/test-db/up.sh) and
#  the target guard refuses anything else. A production migration or seed is
#  an owner action: node scripts/db.mjs <cmd> --target=production ...
# -----------------------------------------------------------------------------
# Pooled. Prisma needs `pgbouncer=true` on this URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# Prisma reads DIRECT_URL (schema.prisma directUrl) for migrations.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require


# -----------------------------------------------------------------------------
#  2. CACHE & QUEUE — none
#  Rate limits, OTP challenges and idempotency keys live in Postgres; jobs run
#  as Vercel Cron routes (/api/jobs/*). No Redis or queue service is used, so
#  there are no variables here.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
#  3. STORAGE — supplier documents (private Supabase Storage bucket)
#  docs/backend/21 §9.1-§9.3, review TKT-3. Server side only: none of these is
#  ever NEXT_PUBLIC_, and no document URL is ever handed out (no public URL,
#  no signed URL): Outly streams each file through a route that checks
#  ownership on every request.
#
#  memory      → in-process, lost on restart; tests and local dev only.
#                Refused in production.
#  supabase_s3 → the bucket below through Storage's S3-compatible endpoint.
#  (unset)     → no store: documents stay pending and nothing is served.
#
#  Use a Storage S3 ACCESS KEY (Project Settings → Storage → S3 access keys),
#  never the service-role key. S3 keys bypass RLS and span every bucket of the
#  project, so keep test documents in a separate non-production project or
#  the disposable local stack (scripts/test-storage/up.sh --workdir <dir>,
#  which writes its own env file outside the repository).
#  Bucket: private, no storage.objects policies for anon or authenticated.
#  Object keys are `<environment>/<32 hex>` and carry nothing else.
#  The endpoint must be https:// (plain http is accepted for 127.0.0.1 or
#  localhost only, for the local stack).
# -----------------------------------------------------------------------------
# memory | supabase_s3
SUPPLIER_DOCS_STORE=
# https://<PROJECT_REF>.storage.supabase.co/storage/v1/s3
SUPPLIER_DOCS_S3_ENDPOINT=
# The project's region as shown beside the S3 endpoint, e.g. eu-central-1.
SUPPLIER_DOCS_S3_REGION=
SUPPLIER_DOCS_S3_ACCESS_KEY_ID=
SUPPLIER_DOCS_S3_SECRET_ACCESS_KEY=
SUPPLIER_DOCS_BUCKET=supplier-documents

# Product photography is served from the Pexels CDN (below); it needs no storage.

# Photography. Every catalogue image is real photography from Pexels:
#   - curated photo ids in src/lib/images/manifest.ts are served straight from
#     the Pexels CDN and need NO key;
#   - this key enables server-side Pexels search for any index the manifest
#     does not curate. Results are cached in the image_assets table (one call
#     per entity per day at most). Free tier: 200 requests/hour.
#   Get one at https://www.pexels.com/api/ — paste it and the site works; no
#   other configuration is required. Leave blank and uncurated slots fall back
#   to the illustrated scene.
PEXELS_API_KEY=


# -----------------------------------------------------------------------------
#  4. AUTH & SECRETS (docs/backend/13 §2)
#  Generate each with:  openssl rand -base64 48
#  Never reuse a value across two variables.
# -----------------------------------------------------------------------------
# Customer JWT (jose). Rotate = every session invalid.
AUTH_JWT_SECRET=
# httpOnly cookie signing.
AUTH_COOKIE_SECRET=
# Encrypts admin TOTP seeds at rest. Losing this locks every admin out.
TOTP_ENCRYPTION_KEY=
# TEMPORARY, deploy-time only (doc 22 §32.9, recheck P3-2). Before this
# branch, a deployment without TOTP_ENCRYPTION_KEY encrypted TOTP seeds with a
# key derived from AUTH_JWT_SECRET; production no longer derives that key. If
# that applies, set TOTP_ENCRYPTION_KEY (new) and set this to the
# AUTH_JWT_SECRET value in use when the admins enrolled. Each admin's seed is
# then re-wrapped under TOTP_ENCRYPTION_KEY at their next successful sign-in
# (audited as auth.totp_rewrapped). Remove this variable once every admin has
# signed in once (no admin_users row left to re-wrap). Leave it empty otherwise.
TOTP_LEGACY_ENCRYPTION_SECRET=

# Key rings for supplier, ticket and recovery data (src/server/lib/crypto.ts,
# PRV-5). One variable per purpose, so a key for one kind of data never opens
# another. Format: comma-separated `<id>:<base64 of exactly 32 bytes>`, where
# <id> is 1-16 lowercase letters or digits, e.g.
#     OUTLY_KEYS_TICKET_CODES=k2:<base64>,k1:<base64>
# The FIRST entry is active (encrypts / hashes); every listed key still
# decrypts. Rotate by adding a new key in front, re-wrapping stored values,
# then dropping the old key. Generate a key with:  openssl rand -base64 32
# Never reuse a key across purposes or environments.
# Production: every ring below is REQUIRED (boot check lists missing or
# malformed rings; there is no fallback). Outside production an unset ring
# falls back to a key derived from AUTH_JWT_SECRET (key id `dev`).
# Encryption purposes (AES-256-GCM):
OUTLY_KEYS_TICKET_CODES=
OUTLY_KEYS_CAPABILITY_TOKENS=
OUTLY_KEYS_SUPPLIER_IDENTIFIERS=
OUTLY_KEYS_RECOVERY=
# HMAC purposes (keyed hashes for values that are only compared):
OUTLY_KEYS_LOOKUP=
OUTLY_KEYS_TICKET_CODE_HASH=
OUTLY_KEYS_ACCESS_COOKIE=

# First admin account, created by `npm run db:seed`. MFA is enrolled on first
# sign-in; nothing works before that. Leave the password blank to have the seed
# generate one and print it once.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
# Admin login attempts allowed per email per 15 minutes.
ADMIN_LOGIN_RATE_LIMIT_PER_15MIN=5
# Session lifetimes.
AUTH_CUSTOMER_SESSION_DAYS=30
AUTH_ADMIN_SESSION_HOURS=8

# Customer phone OTP over SMS — MSG91 (India). DLT template registration is
# mandatory and slow; start it early (docs/backend/13 §2.1).
# OTP delivery port for customer sign-in: log (dev/staging — the code is
# written to the server log, never sent) | msg91 (needs AUTH_KEY + SENDER_ID +
# TEMPLATE_ID_OTP). Sign-in is enabled outside production, and in production
# only when a real provider is configured — override with FEATURE_CUSTOMER_AUTH.
# log | msg91 (we own the code, needs a DLT template) | msg91_widget (MSG91 owns
# the code, no DLT template of ours). The two MSG91 modes are different trust
# models, not variants — only one is live at a time.
SMS_PROVIDER=log
MSG91_AUTH_KEY=
MSG91_SENDER_ID=OUTLYY
MSG91_TEMPLATE_ID_OTP=
MSG91_DLT_ENTITY_ID=
# OTP Widget. Both values are PUBLIC — they ship in the page's JavaScript. Only
# safe while the widget's domain allowlist is set in the MSG91 dashboard.
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_WIDGET_TOKEN=
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5


# -----------------------------------------------------------------------------
#  5. WHATSAPP — Business API via BSP (docs/backend/08)
#  This is the launch line (pivot §Appendix Phase B). The automatic inquiry
#  acknowledgement with a concrete deadline cannot exist without it.
#
#  Variable names follow the Meta Cloud API shape; Wati / Interakt / Gupshup /
#  AiSensy all expose equivalents. Set WHATSAPP_PROVIDER to pick the adapter.
# -----------------------------------------------------------------------------
# meta | wati | interakt | gupshup | aisensy | log   (log = dev no-op adapter)
WHATSAPP_PROVIDER=log
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Inbound webhook: Meta verifies with the verify token; payloads are HMAC'd
# with the app secret.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# Pre-approved template names (docs/backend/08 §4). Two needed at launch.
WHATSAPP_TEMPLATE_INQUIRY_ACK=inquiry_ack_v1
WHATSAPP_TEMPLATE_INQUIRY_FOLLOWUP=inquiry_followup_v1
WHATSAPP_TEMPLATE_INQUIRY_OPS_ALERT=inquiry_ops_alert_v1
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=outlyy_booking_confirmed_v1
WHATSAPP_TEMPLATE_VOUCHER=outlyy_voucher_v1
WHATSAPP_TEMPLATE_DRIVER_DETAILS=outlyy_driver_details_v1
WHATSAPP_TEMPLATE_REVIEW_REQUEST=outlyy_review_request_v1

# Ops alert group for new inquiries / SLA breaches (WhatsApp group or number).
WHATSAPP_OPS_ALERT_NUMBER=

# NON-PRODUCTION SAFETY (docs/backend/14 §1 non-negotiable #3): comma-separated
# numbers that may receive messages outside production. Empty = send nothing.
# Entries: full address/number, an email domain ("@outlyy.com") or a phone prefix ("+9198").
# Outside production an EMPTY list means NOTHING sends (recorded as suppressed).
NOTIFICATION_RECIPIENT_ALLOWLIST=


# -----------------------------------------------------------------------------
#  6. EMAIL — Resend (docs/backend/03 §7)
#  Get: https://resend.com/api-keys. Configure SPF/DKIM/DMARC per domain.
#  Transactional and marketing on separate sending domains (PRD §14.4).
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL="OUTLYY <hello@outlyy.com>"
EMAIL_FROM_MARKETING="OUTLYY <hello@outlyy.com>"
EMAIL_REPLY_TO=hello@outlyy.com
# Inbound webhook signing secret (delivery/bounce events).
RESEND_WEBHOOK_SECRET=
# Dev/staging: every email is redirected here instead of the real recipient.
EMAIL_CATCH_ALL=


# -----------------------------------------------------------------------------
#  7. PAYMENTS — Razorpay (docs/backend/07)
#  Get: https://dashboard.razorpay.com → Settings → API Keys / Webhooks
#  Inquiry mode: agents generate Payment Links manually; the API keys are still
#  needed for webhook verification, reconciliation and refunds.
#  Use rzp_test_* everywhere except production.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public key id is safe in the browser (needed if/when instant checkout is enabled).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_
# Payment link expiry (minutes) for agent-generated links.
RAZORPAY_PAYMENT_LINK_EXPIRY_MINUTES=1440

# UAE / AED gateway — V1, provider TBD (Stripe / Telr / Network International).
# Depends on the OUTLYY entity decision (Blocker B5). Leave blank until chosen.
AED_GATEWAY_PROVIDER=
AED_GATEWAY_KEY_ID=
AED_GATEWAY_KEY_SECRET=
AED_GATEWAY_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
#  8. SUPPLIER APIS (docs/backend/02, 16)
#  Rathin is NOT READY per docs/backend/16 — keep the mock adapter until the
#  Phase 2b validation gate passes. Flipping a SKU to fulfilment_mode='instant'
#  is what turns these on for that SKU.
# -----------------------------------------------------------------------------
# mock | live   (env.ts accepts only these two; "rathin" makes env() throw)
SUPPLIER_ADAPTER_RATHIN=mock
RATHIN_BASE_URL=
RATHIN_CLIENT_ID=
RATHIN_CLIENT_SECRET=
RATHIN_AGENCY_ID=
# Per-call timeout budget (docs/backend/02 §5.2). Never rely on the platform ceiling.
RATHIN_TIMEOUT_MS=8000
# Availability cache TTL (seconds). Always 0 at payment authorisation.
AVAILABILITY_CACHE_TTL_SECONDS=300

# TravelDesk B2B API (docs/backend/21). Stage 1 = READ-ONLY.
#  - Keep `mock` everywhere except a deliberate test-API run.
#  - Put real values in .env.traveldesk.local (git-ignored), never here.
#  - TRAVELDESK_ENV and TRAVELDESK_API_BASE_URL must agree; only two values
#    pass validation:
#      test        https://testapi.traveldesk.me/public/b2b/v1
#      production  https://api.traveldesk.me/public/b2b/v1   (APP_ENV=production only)
#  - Booking mutations are refused in code in Stage 1. Production mutations
#    stay refused until activation is approved, whatever this flag says.
# mock | live
SUPPLIER_ADAPTER_TRAVELDESK=mock
# test | production
TRAVELDESK_ENV=
TRAVELDESK_API_BASE_URL=
TRAVELDESK_API_KEY=
# Reserve/confirm/create budget; TravelDesk requires >= 120000.
TRAVELDESK_TIMEOUT_MS=150000
# Catalogue/availability/balance budget (1000..120000).
TRAVELDESK_READ_TIMEOUT_MS=20000
TRAVELDESK_BOOKINGS_ENABLED=false
# Numeric agency id the key belongs to (GET /balance agencyId). Mutations are refused when /balance reports another agency.
TRAVELDESK_AGENCY_ID=


# -----------------------------------------------------------------------------
#  9. ANALYTICS (docs/backend/11)
#  Our own /api/events is the source of truth; these are downstream forwarders.
# -----------------------------------------------------------------------------
# PostHog Cloud — product analytics, funnels, cohorts.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side project API key (may equal the public key on PostHog).
POSTHOG_API_KEY=

# GA4 — the measurement id is NEXT_PUBLIC_GA_MEASUREMENT_ID (section 1).
# NEXT_PUBLIC_GA4_MEASUREMENT_ID is a deprecated name for the same id: still
# read as a fallback (with a warning) when the canonical name is unset. Do
# not set it in new environments. The API secret (Measurement Protocol) is
# server-only.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Meta — pixel id is public; CAPI token is server-only.
# In inquiry mode: inquiry_submitted → Lead (CAPI), booking_confirmed → Purchase
# via OFFLINE conversion upload (essential — pivot §5.3).
NEXT_PUBLIC_META_PIXEL_ID=
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
# Sends CAPI events to Meta's test tool instead of live optimisation. Blank in prod.
META_CAPI_TEST_EVENT_CODE=
# Marketing API — offline conversion uploads + catalogue feed.
META_MARKETING_API_TOKEN=
META_AD_ACCOUNT_ID=act_
META_OFFLINE_EVENT_SET_ID=


# -----------------------------------------------------------------------------
# 10. ERROR TRACKING — Sentry
#  Get: https://sentry.io → project → Client Keys (DSN); Settings → Auth Tokens
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=outlyy
# CI only — uploads source maps on build.
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.1


# -----------------------------------------------------------------------------
# 11. SECURITY & ABUSE CONTROLS (docs/backend/13, pivot §9)
# -----------------------------------------------------------------------------
# Cloudflare Turnstile — deliberately OFF at launch (conversion cost). Add only
# when spam actually appears. Blank site key = widget not rendered.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Inquiry form anti-spam (honeypot + timing are always on).
INQUIRY_MIN_SUBMIT_SECONDS=2
INQUIRY_RATE_LIMIT_PER_PHONE_PER_HOUR=3
INQUIRY_RATE_LIMIT_PER_IP_PER_HOUR=10
# Booking / inquiry lookup by reference: 5 per IP per 15 minutes.
LOOKUP_RATE_LIMIT_PER_IP=5
LOOKUP_RATE_LIMIT_WINDOW_SECONDS=900
# POST /api/events per anonymous id (or hashed IP) per hour.
EVENTS_RATE_LIMIT_PER_HOUR=1000

# Shared secret for Vercel Cron → route handler calls (Authorization: Bearer).
# Required for /api/jobs/* (Vercel Cron sends it as a Bearer token). Jobs are disabled when blank.
CRON_SECRET=
# Separate secret for manual POST runs of supplier job routes (doc 22 SEC-8). Never reuse CRON_SECRET.
SUPPLIER_JOB_SECRET=
# Token that unlocks detailed /api/health output for operators. Never reuse CRON_SECRET.
HEALTH_DETAIL_TOKEN=
# Internal service-to-service key (admin console → API).
INTERNAL_API_KEY=

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000


# -----------------------------------------------------------------------------
# 12. OPERATIONS — inquiry SLA & routing (pivot §3.9, §7)
#  Admin-editable in production (settings.sla.*); these are boot defaults.
# -----------------------------------------------------------------------------
SLA_INQUIRY_RESPONSE_MINUTES=30
SLA_BUSINESS_HOURS_START=10:00
SLA_BUSINESS_HOURS_END=18:00
# Days the team works: 0 = Sunday … 6 = Saturday.
SLA_BUSINESS_DAYS=1,2,3,4,5,6
SLA_TIMEZONE=Asia/Dubai
# Escalate to agent lead + reassign when breached.
SLA_ESCALATION_MINUTES=30

# Business hours the storefront quotes, mirrored from SLA_* so the promise the
# customer reads and the deadline the server computes cannot drift apart.
# Days: 0 = Sunday … 6 = Saturday. H P D Tourism works Monday to Saturday.
NEXT_PUBLIC_SLA_TIMEZONE=Asia/Dubai
NEXT_PUBLIC_SLA_BUSINESS_START=10:00
NEXT_PUBLIC_SLA_BUSINESS_END=18:00
NEXT_PUBLIC_SLA_BUSINESS_DAYS=1,2,3,4,5,6
NEXT_PUBLIC_SLA_RESPONSE_MINUTES=30
# Routing thresholds (pivot §7.3).
ROUTING_PREMIUM_THRESHOLD_INR=100000
ROUTING_GROUP_THRESHOLD_PAX=5
AGENT_MAX_CONCURRENT_INQUIRIES=15

# Follow-up ladder (hours). T+2h nudge, T+24h softer option, T+72h final, T+7d lost.
FOLLOWUP_LADDER_HOURS=2,24,72,168

# Indicative → confirmed price tolerance before re-consent is required (pivot §10.4).
PRICE_TOLERANCE_PERCENT=5

# Plausible INR-per-AED band for the live FX refresh (/api/jobs/fx-refresh); a rate outside it is refused.
FX_BAND_MIN_INR_PER_AED=15.00
FX_BAND_MAX_INR_PER_AED=40.00

# Ops alert channel for P1s (Slack incoming webhook or email).
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_EMAIL=ops@outlyy.com
# Alias used by the preflight audit (§18 §1.3); comma-separated. Takes precedence when set.
EMAIL_OPS_ALERT_TO=


# -----------------------------------------------------------------------------
# 13. FEATURE FLAGS
#  Per-product fulfilment mode lives in the DB (products.fulfilment_mode) —
#  never as a global env flag (pivot §8.4). These are runtime toggles only.
# -----------------------------------------------------------------------------
# Block /design-system outside dev (docs/backend/14 §1).
FEATURE_DESIGN_SYSTEM_PAGE=true
# Show the response-time promise on the homepage. Turn on only once the SLA
# timer and weekly measurement exist (pivot §3.9).
FEATURE_RESPONSE_PROMISE=true
# Maintenance mode — serves /maintenance for all storefront routes.
FEATURE_MAINTENANCE_MODE=false
# Customer sign-in override (true/false). Unset = auto (see SMS_PROVIDER).
FEATURE_CUSTOMER_AUTH=
# Enables the instant-checkout route even if no SKU is flipped (testing only).
FEATURE_FORCE_CHECKOUT_ROUTE=false
# Environment release switch for instant activation. While false, no product
# can be switched to instant fulfilment. Exactly "true" or "false".
INSTANT_RELEASE_ENABLED=false
# Release switch for the guest same-browser voucher download (checkout
# redesign batch 3, CO-02). While false, no 24-hour checkout download grant is
# issued and none already issued is honoured; the guest uses "Text me a code".
# Exactly "true" or "false". Default false; production stays false until the
# owner turns it on.
GUEST_DOWNLOAD_GRANT_ENABLED=false
# Release switch for the scheduled booking jobs (checkout redesign batch 4;
# pilot-day A10): the cron GETs of /api/jobs/booking-tick, documents-tick and
# supplier-reconcile. While false they answer "skipped" and touch no data.
# Turn on only after the production migrations (A8). Exactly "true" or
# "false". Default false. NOT an emergency stop: once live, turning it off
# also stops webhook processing, refunds and vouchers; stop sales with the
# supplier control row and INSTANT_RELEASE_ENABLED=false (doc 28 §7).
SCHEDULED_BOOKING_JOBS_ENABLED=false
# Its lifetime after the order-bound verification, whole hours, bounded 1-24
# (default 24). Shorter suits shared computers; never extends issued grants.
GUEST_DOWNLOAD_GRANT_HOURS=24


# -----------------------------------------------------------------------------
# 14. CRM — Bitrix24 one-way push (doc 29 §5, §6.4; CRM batches C1, C2a;
#  setup runbook doc 29d). Built switched off and tested against a fake portal
#  only. Every portal value is read on the portal by the owner (doc 29d §3).
#  Production values go in Vercel's Production scope only; never NEXT_PUBLIC_.
#  Validated in src/server/crm/crm.config.ts; any missing or malformed value
#  keeps the worker off ("crm not configured").
#   - No CRM_BITRIX_PORTAL_HOST: nothing is enqueued and nothing is sent.
#   - A portal host and CRM_SYNC_ENABLED=false: nothing new is enqueued (no
#     backfill); only deals already pushed while the sync was on keep queueing
#     their changes and deletes, which wait. Nothing is sent.
#   - CRM_SYNC_ENABLED=true and every value valid: /api/jobs/crm-worker
#     (Vercel Cron, every minute) delivers.
# -----------------------------------------------------------------------------
# Delivery switch. Exactly "true" or "false". Default false.
CRM_SYNC_ENABLED=false
# test | production. production only with APP_ENV=production on Vercel's
# production deployment.
CRM_BITRIX_ENV=
# Bare portal host on a Bitrix24 cloud domain (.bitrix24.com, .eu, .de, .in;
# no https://, path or port).
CRM_BITRIX_PORTAL_HOST=
# Inbound webhook of the dedicated non-admin service user (crm scope only):
# the numeric user id and the secret part of the webhook URL. Treat the
# secret like a password; it is never logged.
CRM_BITRIX_WEBHOOK_USER_ID=
CRM_BITRIX_WEBHOOK_SECRET=
# The OUTLYY deal funnel id. Never 0 (the other business's funnel).
CRM_BITRIX_DEAL_CATEGORY_ID=
# The 12 OUTLYY stages mapped to stages of that funnel, comma-separated:
# new_inquiry=C<id>:NEW,assigned=C<id>:...,contacted=...,quoted=...,
# payment_pending=...,paid_awaiting_supplier=...,
# confirmed_tickets_pending=...,fulfilled=C<id>:WON,lost=C<id>:LOSE,spam=...,
# cancelled=...,refunded=...
CRM_BITRIX_STAGE_IDS=
# The 20 OUTLYY custom deal fields, key=UF_CRM_code, comma-separated (doc 29d
# §3.8): reference, environment, admin_link, customer_name, customer_phone,
# customer_email, payment_status, supplier_booking_status, ticket_status,
# refund_status, refund_amount, travel_date, item_summary, as_of,
# indicative_amount, margin, consent_marketing_email,
# consent_marketing_email_at, consent_marketing_whatsapp,
# consent_marketing_whatsapp_at
CRM_BITRIX_FIELD_CODES=
# Numeric Bitrix24 user id of the sales lead who owns every new deal. Sent on
# create only. Must not be the service account.
CRM_BITRIX_DEFAULT_OWNER_ID=
# The synthetic probe's own secret (doc 29d §5.2a), sent in x-crm-probe-secret
# besides CRON_SECRET; at least 32 characters,
# distinct from CRON_SECRET and every other job secret. Unset: the probe is
# refused. Set only for the W12a/W12b sitting, then remove.
CRM_PROBE_SECRET=
# Per-request timeout, 1000-20000 ms. Default 5000.
CRM_BITRIX_TIMEOUT_MS=5000
