{
  "name": "outlyy",
  "version": "0.1.0",
  "private": true,
  "description": "OUTLYY - Dubai activities marketplace for Indian travellers",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:db": "OUTLY_REQUIRE_DB=1 vitest run --project db",
    "test:render": "vitest run --project render",
    "test:db:up": "sh scripts/test-db/up.sh",
    "test:db:down": "sh scripts/test-db/down.sh",
    "test:storage": "OUTLY_REQUIRE_STORAGE=1 vitest run --project storage",
    "test:storage:up": "sh scripts/test-storage/up.sh",
    "test:storage:down": "sh scripts/test-storage/down.sh",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:a11y": "sh scripts/shop/a11y.sh",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:migrate:dev": "node scripts/db.mjs migrate:dev",
    "db:status": "node scripts/db.mjs status",
    "db:seed": "node scripts/db.mjs seed",
    "db:studio": "node scripts/db.mjs studio",
    "db:purge": "node scripts/db.mjs purge",
    "traveldesk:probe": "node --env-file=.env.traveldesk.local node_modules/tsx/dist/cli.mjs scripts/traveldesk-readonly-probe.ts",
    "traveldesk:probe:production": "node --env-file=.env.traveldesk.production.local node_modules/tsx/dist/cli.mjs scripts/traveldesk-readonly-probe.ts --production-readonly",
    "traveldesk:sync:local": "NODE_OPTIONS=--conditions=react-server node --env-file=.env.test.local --env-file=.env.traveldesk.local node_modules/tsx/dist/cli.mjs scripts/traveldesk-sync-local.ts",
    "traveldesk:sync:local:production": "NODE_OPTIONS=--conditions=react-server node --env-file=.env.test.local --env-file=.env.traveldesk.production.local node_modules/tsx/dist/cli.mjs scripts/traveldesk-sync-local.ts --production-readonly",
    "postinstall": "prisma generate",
    "traveldesk:drill:test": "NODE_OPTIONS=--conditions=react-server node --env-file=.env.test.local --env-file=.env.traveldesk.local node_modules/tsx/dist/cli.mjs scripts/traveldesk-sandbox-drill.ts",
    "traveldesk:drills:named:test": "NODE_OPTIONS=--conditions=react-server node --env-file=.env.test.local --env-file=.env.traveldesk.local node_modules/tsx/dist/cli.mjs scripts/traveldesk-named-drills.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@prisma/client": "^6.19.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "1.5.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "motion": "14.8.0",
    "next": "^16.4.4",
    "radix-ui": "1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "stripe": "23.0.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@neon/config": "^1.4.2",
    "@neon/env": "^1.3.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
